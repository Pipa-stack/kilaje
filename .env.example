# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore:
# nunca se versiona y nunca contiene credenciales reales en el repositorio.

# --- Obligatorio -----------------------------------------------------------

# Cadena de conexión a PostgreSQL. En Railway la inyecta el servicio Postgres
# como referencia: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kilaje?sslmode=disable

# Certificado (PEM) de la autoridad que firma el de PostgreSQL. Con él, el
# servidor verifica de verdad contra quién se conecta; sin él el TLS cifra pero
# acepta cualquier certificado. Irrelevante mientras se llegue por la red
# privada de Railway (*.railway.internal), donde no se usa TLS; imprescindible
# si DATABASE_URL apunta al proxy público.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Opcional --------------------------------------------------------------

# Puerto del servidor. Railway lo inyecta automáticamente.
PORT=8080

# Importa `Ejemplo/ejemplo.xlsx` al arrancar si la base de datos está vacía.
# Útil para el primer despliegue; no sobrescribe programas existentes.
SEED_REFERENCE_PROGRAM=false

# Ruta alternativa del libro a usar en `npm run db:seed`.
# SEED_WORKBOOK=./Ejemplo/ejemplo.xlsx

# Cuenta fija para probar la app sin registrarse cada vez. Con `true` el
# servidor la recrea en cada arranque: si falta la crea, si la contraseña no
# coincide la restablece, y si no tiene programa le importa el de ejemplo.
# Cualquiera que conozca la contraseña entra. DEMO_PASSWORD es obligatoria: sin
# ella el servidor avisa y no crea la cuenta, en vez de generar una contraseña
# y escribirla en el log. Para una de usar y tirar: `npm run db:seed:demo`.
DEMO_ACCOUNT=false
# DEMO_EMAIL=demo@kilaje.app
# DEMO_PASSWORD=pon-aqui-una-contrasena-larga

# A dónde envía `npm run dev` las peticiones /api (por defecto localhost:8080).
# API_PROXY_TARGET=http://localhost:8080

# --- Correo (recuperación de contraseña) -----------------------------------
#
# Sin ninguna de estas variables la app arranca igual, pero el enlace de
# recuperación no se envía a nadie y el arranque lo avisa en el log.
#
# Hay dos proveedores y basta con uno. Si defines los dos, gana SMTP.
#
# Opción A — SMTP (no necesita dominio propio). Con Gmail hace falta la
# verificación en dos pasos activada y una "contraseña de aplicación": la
# contraseña normal de la cuenta no sirve. El remitente será la propia
# dirección, que es la única que Gmail acepta de esa cuenta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Opción B — Resend (necesita un dominio verificado por DNS; sin él solo
# entrega a la dirección dueña de la cuenta de Resend).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Kilaje <no-reply@mail.tudominio.com>

# Dónde avisar cuando el servidor responde con un error interno.
#
# Sin esto los 500 solo quedan en el log de Railway, que nadie tiene motivo
# para abrir: el fallo lo descubre quien esté entrenando. Necesita además un
# proveedor de correo configurado arriba; con uno solo de los dos no avisa.
#
# Como mucho un correo cada 15 minutos, con la cuenta de los que se callaron,
# para que un fallo en bucle no te llene el buzón.
# ALERT_EMAIL=tu@correo.com
#
# Origen absoluto con el que se construye el enlace del correo.
# APP_URL=https://kilaje.up.railway.app

# Solo para tests: si está definida, la suite se ejecuta contra este PostgreSQL
# real en lugar de PGlite. Cada fichero de test usa su propio esquema.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kilaje_test?sslmode=disable
